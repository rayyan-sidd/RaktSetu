# RaktSetu Environment Configuration Template
# Copy to .env or .env.local to customize local development settings.

# Backend API Base URL for Vite Frontend (leave blank in dev to use Vite proxy /api)
# Set only if pointing directly to an external or standalone API server without Vite proxy.
VITE_API_BASE_URL=

# SQLite Database URL for FastAPI Backend (default: sqlite:///data/raktsetu.db)
RAKTSETU_DATABASE_URL=sqlite:///data/raktsetu.db

# TinyFish API Key for external portal queries (optional, left blank by default)
# Never commit real API keys to version control.
TINYFISH_API_KEY=

# Telegram Discovery Bot Configuration
# Bot Token provided by @BotFather (leave blank if not running the bot)
TELEGRAM_BOT_TOKEN=

# Internal API Base URL for the Telegram Bot to query (default: http://127.0.0.1:8000)
RAKTSETU_API_BASE_URL=http://127.0.0.1:8000

# Optional Public Web URL for the RaktSetu discovery frontend (leave blank if not hosted)
RAKTSETU_WEB_URL=

# Gnani AI Speech Integration (Prisma STT & Timbre TTS)
# API key obtained from Gnani / Vachana AI developer portal (https://vachana.ai)
# Leave blank to run bot in text-only mode without voice transcription.
# Never commit real API keys to version control.
GNANI_API_KEY=
# Alternative header identifier if specified by account (optional, defaults to GNANI_API_KEY)
GNANI_API_KEY_ID=

# Gnani API Base URL (default: https://api.vachana.ai)
GNANI_API_BASE_URL=https://api.vachana.ai

# Prisma Speech-to-Text (STT) Settings
GNANI_STT_MODEL=prisma-v3.0
GNANI_STT_LANGUAGE_CODE=indic-auto
GNANI_STT_FORMAT=transcribe

# Timbre Text-to-Speech (TTS) Settings
GNANI_TTS_MODEL=timbre-v3.0
GNANI_TTS_VOICE=Nalini
GNANI_TTS_LANGUAGE=hi-IN
GNANI_TTS_SPEED=1.0

# Speech API Request Timeout in seconds (default: 15.0)
GNANI_REQUEST_TIMEOUT=15.0

