# Frontend Environment Configuration
# Copy to .env or .env.local to override local API endpoints.

# API Base URL: Leave blank in local development to use the Vite proxy (/api).
# Set only if connecting directly to a remote or standalone API server without Vite proxy.
# Example for direct deployment: VITE_API_BASE_URL=https://api.raktsetu.org
VITE_API_BASE_URL=
